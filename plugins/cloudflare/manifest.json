{
  "$schema": "../../manifest.schema.json",
  "manifestVersion": 1,
  "id": "cloudflare",
  "name": "Cloudflare",
  "version": "1.1.0",
  "publisher": "Dache",
  "dashboardUrl": "https://dash.cloudflare.com",
  "tokenUrl": "https://dash.cloudflare.com/profile/api-tokens",
  "tokenHelp": "Create a custom token with Account Settings, Zone, DNS, Cloudflare Pages and Workers Scripts. Add SSL and Certificates, R2, KV, D1, Queues and Cloudflare Tunnel to fill those pages too. The checklist below shows what the token can read. To edit DNS records and retry or roll back Pages deployments, add DNS Edit and Cloudflare Pages Edit.",
  "hosts": ["api.cloudflare.com"],
  "auth": { "type": "bearer" },
  "capabilities": ["DOMAINS", "DNS", "SITES", "DEPLOYMENTS", "WORKERS", "SERVICES"],
  "validate": {
    "request": { "url": "https://api.cloudflare.com/client/v4/accounts", "query": { "per_page": "5" } },
    "displayName": "result.0.name | default:Cloudflare",
    "permission": "Account Settings Read"
  },
  "resources": [
    {
      "kind": "domain",
      "permission": "Zone Read",
      "request": {
        "url": "https://api.cloudflare.com/client/v4/zones",
        "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://dash.cloudflare.com/{account.id}/{name}",
        "certificates": {
          "request": {
            "url": "https://api.cloudflare.com/client/v4/zones/{id}/ssl/certificate_packs",
            "query": { "status": "all" }
          },
          "permission": "SSL and Certificates Read",
          "optional": true,
          "from": "result",
          "fields": {
            "nativeId": "id",
            "status": "status",
            "hosts": "hosts",
            "expiresAt": "certificates.0.expires_on | date"
          },
          "statusMap": {
            "active": "ACTIVE",
            "staging_active": "ACTIVE",
            "backup_issued": "ACTIVE",
            "initializing": "PENDING",
            "pending_validation": "PENDING",
            "pending_issuance": "PENDING",
            "pending_deployment": "PENDING",
            "staging_deployment": "PENDING",
            "holding_deployment": "PENDING",
            "pending_expiration": "ACTIVE",
            "expired": "EXPIRED",
            "initializing_timed_out": "FAILED",
            "validation_timed_out": "FAILED",
            "issuance_timed_out": "FAILED",
            "deployment_timed_out": "FAILED",
            "deletion_timed_out": "FAILED",
            "deleted": "INACTIVE",
            "pending_deletion": "INACTIVE",
            "pending_cleanup": "INACTIVE",
            "deactivating": "INACTIVE",
            "inactive": "INACTIVE"
          }
        }
      }
    },
    {
      "kind": "dnsRecord",
      "permission": "DNS Read",
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/zones",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 10 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/zones/{id}/dns_records",
        "paging": { "type": "page", "sizeParam": "per_page", "size": 500, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "webUrl": "https://dash.cloudflare.com/{^.account.id}/{^.name}/dns/records",
        "zoneName": "^.name",
        "type": "type",
        "name": "name",
        "content": "content"
      }
    },
    {
      "kind": "site",
      "permission": "Cloudflare Pages Read",
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{id}/pages/projects",
        "paging": { "type": "page", "sizeParam": "per_page", "size": 10, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://dash.cloudflare.com/{^.id}/pages/view/{name}",
        "primaryUrl": "https://{subdomain}",
        "customDomains": "domains",
        "repoUrl": "https://{source.type}.com/{source.config.owner}/{source.config.repo_name}",
        "deployments": {
          "request": {
            "url": "https://api.cloudflare.com/client/v4/accounts/{^.id}/pages/projects/{name}/deployments",
            "query": { "per_page": "10" }
          },
          "from": "result",
          "fields": {
            "nativeId": "id",
            "webUrl": "https://dash.cloudflare.com/{^.^.id}/pages/view/{^.name}/{id}",
            "status": "latest_stage.status",
            "branch": "deployment_trigger.metadata.branch",
            "commitMessage": "deployment_trigger.metadata.commit_message",
            "createdAt": "created_on | date"
          },
          "statusMap": {
            "success": "SUCCESS",
            "failure": "FAILED",
            "canceled": "CANCELLED",
            "skipped": "CANCELLED",
            "active": "BUILDING",
            "idle": "BUILDING"
          }
        }
      }
    },
    {
      "kind": "worker",
      "permission": "Workers Scripts Read",
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": { "url": "https://api.cloudflare.com/client/v4/accounts/{id}/workers/scripts" },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "name": "id",
        "webUrl": "https://dash.cloudflare.com/{^.id}/workers/services/view/{id}/production",
        "routes": "routes.pattern",
        "modifiedAt": "modified_on | date"
      }
    },
    {
      "kind": "service",
      "service": { "id": "r2Bucket", "label": "R2 buckets" },
      "permission": "Workers R2 Storage Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{id}/r2/buckets",
        "query": { "per_page": "1000" }
      },
      "items": "result.buckets",
      "fields": {
        "nativeId": "name",
        "name": "name",
        "webUrl": "https://dash.cloudflare.com/{^.id}/r2/default/buckets/{name}",
        "detail": "location",
        "createdAt": "creation_date | date"
      }
    },
    {
      "kind": "service",
      "service": { "id": "kvNamespace", "label": "KV namespaces" },
      "permission": "Workers KV Storage Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{id}/storage/kv/namespaces",
        "paging": { "type": "page", "sizeParam": "per_page", "size": 100, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "name": "title",
        "webUrl": "https://dash.cloudflare.com/{^.id}/workers/kv/namespaces/{id}"
      }
    },
    {
      "kind": "service",
      "service": { "id": "d1Database", "label": "D1 databases" },
      "permission": "D1 Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{id}/d1/database",
        "paging": { "type": "page", "sizeParam": "per_page", "size": 100, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "uuid",
        "name": "name",
        "webUrl": "https://dash.cloudflare.com/{^.id}/workers/d1/databases/{uuid}",
        "detail": "version",
        "createdAt": "created_at | date"
      }
    },
    {
      "kind": "service",
      "service": { "id": "queue", "label": "Queues" },
      "permission": "Queues Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": { "url": "https://api.cloudflare.com/client/v4/accounts/{id}/queues" },
      "items": "result",
      "fields": {
        "nativeId": "queue_id",
        "name": "queue_name",
        "webUrl": "https://dash.cloudflare.com/{^.id}/workers/queues/view/{queue_id}",
        "detail": "{consumers_total_count} consumers",
        "createdAt": "created_on | date",
        "updatedAt": "modified_on | date"
      }
    },
    {
      "kind": "service",
      "service": { "id": "tunnel", "label": "Tunnels" },
      "permission": "Cloudflare Tunnel Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.cloudflare.com/client/v4/accounts",
          "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 4 }
        },
        "items": "result"
      },
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{id}/cfd_tunnel",
        "query": { "is_deleted": "false" },
        "paging": { "type": "page", "sizeParam": "per_page", "size": 50, "maxPages": 10 }
      },
      "items": "result",
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://one.dash.cloudflare.com/{^.id}/networks/tunnels",
        "status": "status",
        "createdAt": "created_at | date",
        "updatedAt": "conns_active_at | date"
      },
      "statusMap": { "healthy": "HEALTHY", "degraded": "DEGRADED", "down": "DOWN", "inactive": "INACTIVE" }
    }
  ],
  "actions": [
    {
      "id": "edit-record",
      "label": "Edit record",
      "target": "dnsRecord",
      "permission": "DNS Edit",
      "inputs": [
        {
          "key": "content",
          "label": "Content",
          "default": "content"
        },
        {
          "key": "ttl",
          "label": "TTL (seconds, 1 = automatic)",
          "type": "number",
          "default": "ttl"
        },
        {
          "key": "proxied",
          "label": "Proxied through Cloudflare",
          "type": "boolean",
          "default": "proxied | default:false"
        }
      ],
      "request": {
        "url": "https://api.cloudflare.com/client/v4/zones/{^.id}/dns_records/{id}",
        "method": "PATCH"
      },
      "body": {
        "content": "{input.content}",
        "ttl": "{input.ttl}",
        "proxied": "{input.proxied}"
      }
    },
    {
      "id": "delete-record",
      "label": "Delete record",
      "target": "dnsRecord",
      "destructive": true,
      "permission": "DNS Edit",
      "request": {
        "url": "https://api.cloudflare.com/client/v4/zones/{^.id}/dns_records/{id}",
        "method": "DELETE"
      }
    },
    {
      "id": "retry-deployment",
      "label": "Retry",
      "target": "deployment",
      "permission": "Cloudflare Pages Edit",
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{^.^.id}/pages/projects/{^.name}/deployments/{id}/retry",
        "method": "POST"
      }
    },
    {
      "id": "rollback-deployment",
      "label": "Roll back to this",
      "target": "deployment",
      "destructive": true,
      "permission": "Cloudflare Pages Edit",
      "description": "Makes this deployment the project's production deployment again.",
      "request": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{^.^.id}/pages/projects/{^.name}/deployments/{id}/rollback",
        "method": "POST"
      }
    }
  ],
  "pages": [
    { "id": "dns", "title": "DNS", "resources": ["domain", "dnsRecord"] },
    { "id": "pages", "title": "Pages", "resources": ["site"] },
    { "id": "workers", "title": "Workers", "resources": ["worker"] },
    { "id": "r2", "title": "R2", "resources": ["r2Bucket"] },
    { "id": "kv", "title": "KV", "resources": ["kvNamespace"] },
    { "id": "d1", "title": "D1", "resources": ["d1Database"] },
    { "id": "queues", "title": "Queues", "resources": ["queue"] },
    { "id": "tunnels", "title": "Tunnels", "resources": ["tunnel"] }
  ]
}
