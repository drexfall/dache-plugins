{
  "$schema": "../../manifest.schema.json",
  "manifestVersion": 1,
  "id": "vercel",
  "name": "Vercel",
  "version": "1.3.1",
  "publisher": "Dache",
  "dashboardUrl": "https://vercel.com/dashboard",
  "tokenUrl": "https://vercel.com/account/tokens",
  "tokenHelp": "Scope the token to the one team you want to see and give it an expiry date. Enter that team’s slug below. Redeploy and roll back need the token's scope to include the team.",
  "hosts": ["api.vercel.com"],
  "auth": { "type": "bearer" },
  "settings": [
    {
      "key": "team",
      "label": "Team slug",
      "hint": "The part after vercel.com/ on your team's dashboard. Leave blank for your personal account."
    }
  ],
  "capabilities": ["SITES", "DEPLOYMENTS", "DOMAINS", "DNS", "SERVICES"],
  "validate": {
    "request": { "url": "https://api.vercel.com/v2/user" },
    "displayName": "user.email | default:Vercel"
  },
  "resources": [
    {
      "kind": "site",
      "request": {
        "url": "https://api.vercel.com/v10/projects",
        "query": { "slug": "{@team}" },
        "paging": {
          "type": "cursor",
          "param": "until",
          "next": "pagination.next",
          "sizeParam": "limit",
          "size": 100,
          "maxPages": 10
        }
      },
      "items": "projects",
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://vercel.com/{@team}/{name}",
        "primaryUrl": "https://{alias.0.domain}",
        "customDomains": "alias.domain",
        "repoUrl": "https://github.com/{link.org}/{link.repo}",
        "deployments": {
          "request": {
            "url": "https://api.vercel.com/v7/deployments",
            "query": { "projectId": "{id}", "limit": "5", "slug": "{@team}" }
          },
          "from": "deployments",
          "fields": {
            "nativeId": "uid",
            "webUrl": "inspectorUrl",
            "status": "readyState",
            "branch": "meta.githubCommitRef",
            "commitMessage": "meta.githubCommitMessage",
            "createdAt": "created | millis"
          },
          "statusMap": {
            "READY": "SUCCESS",
            "ERROR": "FAILED",
            "CANCELED": "CANCELLED",
            "QUEUED": "BUILDING",
            "INITIALIZING": "BUILDING",
            "BUILDING": "BUILDING"
          }
        }
      }
    },
    {
      "kind": "domain",
      "permission": "Domains Read",
      "optional": true,
      "request": {
        "url": "https://api.vercel.com/v5/domains",
        "query": { "slug": "{@team}" },
        "paging": {
          "type": "cursor",
          "param": "until",
          "next": "pagination.next",
          "sizeParam": "limit",
          "size": 100,
          "maxPages": 10
        }
      },
      "items": "domains",
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://vercel.com/{@team}/~/domains/{name}",
        "expiresAt": "expiresAt | millis"
      }
    },
    {
      "kind": "dnsRecord",
      "permission": "Domains Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.vercel.com/v5/domains",
          "query": { "slug": "{@team}" },
          "paging": {
            "type": "cursor",
            "param": "until",
            "next": "pagination.next",
            "sizeParam": "limit",
            "size": 100,
            "maxPages": 10
          }
        },
        "items": "domains"
      },
      "request": {
        "url": "https://api.vercel.com/v4/domains/{name}/records",
        "query": { "slug": "{@team}" },
        "paging": {
          "type": "cursor",
          "param": "until",
          "next": "pagination.next",
          "sizeParam": "limit",
          "size": 100,
          "maxPages": 10
        }
      },
      "items": "records",
      "fields": {
        "nativeId": "id",
        "webUrl": "https://vercel.com/{@team}/~/domains/{^.name}",
        "zoneName": "^.name",
        "type": "type",
        "name": "name | default:@",
        "content": "value"
      }
    },
    {
      "kind": "service",
      "service": { "id": "edgeConfig", "label": "Edge Config stores" },
      "permission": "Edge Config Read",
      "optional": true,
      "request": { "url": "https://api.vercel.com/v1/edge-config", "query": { "slug": "{@team}" } },
      "fields": {
        "nativeId": "id",
        "name": "slug",
        "webUrl": "https://vercel.com/{@team}/~/stores",
        "detail": "{itemCount} items",
        "createdAt": "createdAt | millis",
        "updatedAt": "updatedAt | millis"
      }
    },
    {
      "kind": "service",
      "service": {
        "id": "env",
        "label": "Environment variables"
      },
      "forEach": {
        "request": {
          "url": "https://api.vercel.com/v10/projects",
          "query": {
            "slug": "{@team}"
          },
          "paging": { "type": "cursor", "param": "until", "next": "pagination.next", "sizeParam": "limit", "size": 100, "maxPages": 10 }
        },
        "items": "projects"
      },
      "request": {
        "url": "https://api.vercel.com/v10/projects/{id}/env",
        "query": {
          "slug": "{@team}"
        }
      },
      "items": "envs",
      "permission": "Environment Variables Read",
      "optional": true,
      "fields": {
        "nativeId": "id",
        "name": "key",
        "detail": "{^.name} · {type}",
        "updatedAt": "updatedAt | millis"
      }
    }
  ],
  "status": {
    "url": "https://www.vercel-status.com/api/v2/summary.json",
    "pageUrl": "https://www.vercel-status.com",
    "indicator": "status.indicator",
    "description": "status.description",
    "levelMap": {
      "none": "OPERATIONAL",
      "minor": "DEGRADED",
      "major": "PARTIAL_OUTAGE",
      "critical": "MAJOR_OUTAGE",
      "maintenance": "MAINTENANCE"
    },
    "components": {
      "items": "components",
      "fields": {
        "id": "id",
        "name": "name",
        "status": "status",
        "parent": "group_id"
      },
      "statusMap": {
        "operational": "OPERATIONAL",
        "degraded_performance": "DEGRADED",
        "partial_outage": "PARTIAL_OUTAGE",
        "major_outage": "MAJOR_OUTAGE",
        "under_maintenance": "MAINTENANCE"
      }
    },
    "incidents": {
      "items": "incidents",
      "fields": {
        "name": "name",
        "status": "status",
        "impact": "impact",
        "updatedAt": "updated_at | date",
        "url": "shortlink"
      },
      "statusMap": {
        "none": "OPERATIONAL",
        "minor": "DEGRADED",
        "major": "PARTIAL_OUTAGE",
        "critical": "MAJOR_OUTAGE",
        "maintenance": "MAINTENANCE"
      }
    }
  },
  "actions": [
    {
      "id": "redeploy",
      "label": "Redeploy",
      "target": "deployment",
      "description": "Builds this deployment again with its settings.",
      "request": {
        "url": "https://api.vercel.com/v13/deployments",
        "method": "POST",
        "query": {
          "slug": "{@team}"
        }
      },
      "body": {
        "name": "{^.name}",
        "deploymentId": "{uid}"
      }
    },
    {
      "id": "rollback",
      "label": "Roll back to this",
      "target": "deployment",
      "destructive": true,
      "permission": "Full account",
      "description": "Points the project's production domains at this deployment.",
      "request": {
        "url": "https://api.vercel.com/v1/projects/{^.id}/rollback/{uid}",
        "method": "POST",
        "query": {
          "slug": "{@team}"
        }
      }
    },
    {
      "id": "edit-env",
      "label": "Change value",
      "target": "service:env",
      "destructive": true,
      "permission": "Environment Variables Write",
      "description": "Sets a new value. Deployments pick it up when they next build.",
      "inputs": [
        {
          "key": "value",
          "label": "New value"
        }
      ],
      "request": {
        "url": "https://api.vercel.com/v9/projects/{^.id}/env/{id}",
        "method": "PATCH",
        "query": {
          "slug": "{@team}"
        }
      },
      "body": {
        "value": "{input.value}"
      }
    },
    {
      "id": "delete-env",
      "label": "Delete",
      "target": "service:env",
      "destructive": true,
      "permission": "Environment Variables Write",
      "request": {
        "url": "https://api.vercel.com/v9/projects/{^.id}/env/{id}",
        "method": "DELETE",
        "query": {
          "slug": "{@team}"
        }
      }
    }
  ],
  "pages": [
    { "id": "projects", "title": "Projects", "resources": ["site", "env"] },
    { "id": "domains", "title": "Domains", "resources": ["domain", "dnsRecord"] },
    { "id": "edge-config", "title": "Edge Config", "resources": ["edgeConfig"] }
  ]
}
