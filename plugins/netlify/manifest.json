{
  "$schema": "../../manifest.schema.json",
  "manifestVersion": 1,
  "id": "netlify",
  "name": "Netlify",
  "version": "1.3.0",
  "publisher": "Dache",
  "dashboardUrl": "https://app.netlify.com",
  "tokenUrl": "https://app.netlify.com/user/applications#personal-access-tokens",
  "tokenHelp": "Netlify personal access tokens can’t be scoped. Give it an expiry date and use it only for Dache. Actions (deploys, deleting DNS records) use the same token.",
  "hosts": ["api.netlify.com"],
  "auth": { "type": "bearer" },
  "capabilities": ["SITES", "DEPLOYMENTS", "DOMAINS", "DNS", "SERVICES"],
  "validate": {
    "request": { "url": "https://api.netlify.com/api/v1/user" },
    "displayName": "email | default:Netlify"
  },
  "resources": [
    {
      "kind": "site",
      "request": {
        "url": "https://api.netlify.com/api/v1/sites",
        "query": { "filter": "all" },
        "paging": { "type": "page", "param": "page", "sizeParam": "per_page", "size": 100, "maxPages": 10 }
      },
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "admin_url",
        "primaryUrl": "ssl_url",
        "customDomains": ["custom_domain | lower", "domain_aliases"],
        "repoUrl": "build_settings.repo_url",
        "deployments": {
          "request": {
            "url": "https://api.netlify.com/api/v1/sites/{id}/deploys",
            "query": { "per_page": "10" }
          },
          "from": "$",
          "fields": {
            "nativeId": "id",
            "webUrl": "deploy_ssl_url",
            "status": "state",
            "branch": "branch",
            "commitMessage": "title",
            "createdAt": "created_at | date",
            "durationSeconds": "deploy_time"
          },
          "statusMap": {
            "ready": "SUCCESS",
            "error": "FAILED",
            "rejected": "CANCELLED",
            "new": "BUILDING",
            "pending_review": "BUILDING",
            "accepted": "BUILDING",
            "enqueued": "BUILDING",
            "building": "BUILDING",
            "uploading": "BUILDING",
            "uploaded": "BUILDING",
            "preparing": "BUILDING",
            "prepared": "BUILDING",
            "processing": "BUILDING",
            "processed": "BUILDING",
            "retrying": "BUILDING"
          }
        }
      }
    },
    {
      "kind": "domain",
      "permission": "DNS Read",
      "optional": true,
      "request": { "url": "https://api.netlify.com/api/v1/dns_zones" },
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://app.netlify.com/teams/{account_slug}/dns/{name}"
      }
    },
    {
      "kind": "dnsRecord",
      "permission": "DNS Read",
      "optional": true,
      "forEach": { "request": { "url": "https://api.netlify.com/api/v1/dns_zones" } },
      "request": { "url": "https://api.netlify.com/api/v1/dns_zones/{id}/dns_records" },
      "fields": {
        "nativeId": "id",
        "webUrl": "https://app.netlify.com/teams/{^.account_slug}/dns/{^.name}",
        "zoneName": "^.name",
        "type": "type",
        "name": "hostname",
        "content": "value"
      }
    },
    {
      "kind": "service",
      "service": { "id": "form", "label": "Forms" },
      "permission": "Forms Read",
      "optional": true,
      "forEach": {
        "request": {
          "url": "https://api.netlify.com/api/v1/sites",
          "query": { "filter": "all" },
          "paging": { "type": "page", "param": "page", "sizeParam": "per_page", "size": 100, "maxPages": 10 }
        }
      },
      "request": { "url": "https://api.netlify.com/api/v1/sites/{id}/forms" },
      "fields": {
        "nativeId": "id",
        "name": "name",
        "webUrl": "https://app.netlify.com/sites/{^.name}/forms/{id}",
        "detail": "{submission_count} submissions",
        "createdAt": "created_at | date"
      }
    }
  ],
  "status": {
    "url": "https://www.netlifystatus.com/api/v2/summary.json",
    "pageUrl": "https://www.netlifystatus.com",
    "indicator": "status.indicator",
    "description": "status.description",
    "levelMap": {
      "none": "OPERATIONAL",
      "minor": "DEGRADED",
      "major": "PARTIAL_OUTAGE",
      "critical": "MAJOR_OUTAGE",
      "maintenance": "MAINTENANCE"
    },
    "components": {
      "items": "components",
      "fields": {
        "id": "id",
        "name": "name",
        "status": "status",
        "parent": "group_id"
      },
      "statusMap": {
        "operational": "OPERATIONAL",
        "degraded_performance": "DEGRADED",
        "partial_outage": "PARTIAL_OUTAGE",
        "major_outage": "MAJOR_OUTAGE",
        "under_maintenance": "MAINTENANCE"
      }
    },
    "incidents": {
      "items": "incidents",
      "fields": {
        "name": "name",
        "status": "status",
        "impact": "impact",
        "updatedAt": "updated_at | date",
        "url": "shortlink"
      },
      "statusMap": {
        "none": "OPERATIONAL",
        "minor": "DEGRADED",
        "major": "PARTIAL_OUTAGE",
        "critical": "MAJOR_OUTAGE",
        "maintenance": "MAINTENANCE"
      }
    }
  },
  "actions": [
    {
      "id": "trigger-deploy",
      "label": "Trigger deploy",
      "target": "site",
      "description": "Starts a new build of the site from its linked repository.",
      "request": {
        "url": "https://api.netlify.com/api/v1/sites/{id}/builds",
        "method": "POST"
      }
    },
    {
      "id": "delete-record",
      "label": "Delete record",
      "target": "dnsRecord",
      "destructive": true,
      "permission": "Personal access token",
      "description": "Removes this DNS record from the zone.",
      "request": {
        "url": "https://api.netlify.com/api/v1/dns_zones/{^.id}/dns_records/{id}",
        "method": "DELETE"
      }
    }
  ],
  "pages": [
    { "id": "sites", "title": "Sites", "resources": ["site"] },
    { "id": "dns", "title": "DNS", "resources": ["domain", "dnsRecord"] },
    { "id": "forms", "title": "Forms", "resources": ["form"] }
  ]
}
